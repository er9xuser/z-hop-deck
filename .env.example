# Copy to .env and fill in:  cp .env.example .env && nano .env
# .env is ignored by git - keep passwords and addresses only there.

# --- where your model files are on the host (mounted as /library in the container)
LIBRARY_PATH=/srv/3d-models
# files written by the app (uploads, moves) belong to this user/group on the host - see: id <user>
PUID=1000
PGID=1000

# --- login
# password for the login screen (empty = no login - only on a trusted network!)
APP_PASSWORD=change-me
# reverse proxy that does single sign-on (Authelia, Authentik ...): its IP; requests from it
# carrying the Remote-User header are logged in automatically
AUTH_PROXY_IPS=
# IPs / subnets that never need a password, e.g. 192.168.1.20,192.168.1.0/24
TRUSTED_NETWORKS=
# where "Log out" sends you when signed in through the proxy, e.g. https://auth.example.lan/logout
LOGOUT_URL=

# --- links
# address slicers download from for "Open in slicer" (only if auto-detection is wrong), e.g. http://192.168.1.10:8080
PUBLIC_URL=
# Spoolman, as the server reaches it, e.g. http://192.168.1.30:7912 (can also be set in Settings)
SPOOLMAN_URL=
# Spoolman link for the browser, if different (e.g. https://spoolman.example.lan)
SPOOLMAN_WEB_URL=

# --- misc
TZ=Europe/Berlin
# minutes between automatic rescans (0 = off)
SCAN_INTERVAL=30
MAX_UPLOAD_MB=4096
# port on the host
PORT=8080
# container memory limit (OpenSCAD / STEP conversion / big models need headroom)
MEM_LIMIT=2g
# worker threads (parallel requests); default 16
# THREADS=16
# use your own build instead of the published image: docker compose up -d --build
# ZHOPDECK_IMAGE=zhopdeck:local
